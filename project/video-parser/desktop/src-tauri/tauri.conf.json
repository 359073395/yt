{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "跑量影链工坊",
  "version": "1.10.0",
  "identifier": "org.yinglian.desktop.preview",
  "mainBinaryName": "paoliang-preview",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "跑量影链工坊 1.10.0",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "resources": ["resources/bin/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NjJDOTAxMTg3NTJFRDYKUldUV0xuVVlBY2xpdFR4Y0dLTDdkTkpSUWVkOUkraEUzZEpvVWREdzAzSFpoYTZ0L1dId1pUY1oK",
      "endpoints": [
        "https://github.com/359073395/yt/releases/latest/download/paoliang-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
